{
  "name": "patchgen",
  "version": "1.0.0",
  "description": "A CLI tool to generate .patch files from git repositories",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "patchgen": "./dist/cli/run.js",
    "git-patchgen": "./dist/cli/run.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsx src/cli/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "../zero-release/bin/zero-release --branches main --plugins release-notes,changelog,package-json,git-commit,npm",
    "release:dry-run": "../zero-release/bin/zero-release --dry-run --branches main --plugins release-notes,changelog,package-json,git-commit,npm"
  },
  "keywords": [
    "git",
    "patch",
    "cli",
    "diff",
    "format-patch"
  ],
  "author": "Teles <github.com/teles>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teles/patchgen.git"
  },
  "bugs": {
    "url": "https://github.com/teles/patchgen/issues"
  },
  "homepage": "https://github.com/teles/patchgen#readme",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "execa": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
