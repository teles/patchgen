{
  "name": "patchgen",
  "version": "1.0.0",
  "description": "A CLI tool to generate .patch files from git repositories",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "patchgen": "./dist/cli/run.js",
    "git-patchgen": "./dist/cli/run.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsx src/cli/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "git",
    "patch",
    "cli",
    "diff",
    "format-patch"
  ],
  "author": "Teles <github.com/teles>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teles/patchgen.git"
  },
  "bugs": {
    "url": "https://github.com/teles/patchgen/issues"
  },
  "homepage": "https://github.com/teles/patchgen#readme",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "execa": "^9.3.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.4",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "semantic-release": "^25.0.3",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
